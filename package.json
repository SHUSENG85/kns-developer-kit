{
  "name": "kns-developer-kit",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "kns": "node --import tsx tooling/kns.ts",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
