{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smkkn.top/developer-contract/v1/capability-callable.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "contractVersion",
    "capability",
    "ownerDomain",
    "permission",
    "sensitivity",
    "contractReference",
    "relatedEvents",
    "operations",
    "bounds",
    "dataStates",
    "semantics",
    "authorization"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "capability": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
          "type": "string"
        },
        "version": {
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      }
    },
    "ownerDomain": {
      "minLength": 1,
      "maxLength": 80,
      "type": "string"
    },
    "permission": {
      "minLength": 1,
      "maxLength": 100,
      "type": "string"
    },
    "sensitivity": {
      "anyOf": [
        {
          "const": "PUBLIC",
          "type": "string"
        },
        {
          "const": "INTERNAL",
          "type": "string"
        },
        {
          "const": "SENSITIVE",
          "type": "string"
        },
        {
          "const": "HIGHLY_SENSITIVE",
          "type": "string"
        }
      ]
    },
    "contractReference": {
      "pattern": "^/api/v1/[a-z][a-z0-9-]*/",
      "type": "string"
    },
    "relatedEvents": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "pattern": "^[a-z]+(?:\\.[a-z]+)+\\.v[1-9][0-9]*$",
        "type": "string"
      }
    },
    "operations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operationId",
          "method",
          "path",
          "permission",
          "parameters",
          "responses"
        ],
        "properties": {
          "operationId": {
            "minLength": 1,
            "type": "string"
          },
          "method": {
            "const": "GET",
            "type": "string"
          },
          "path": {
            "pattern": "^/api/v1/",
            "type": "string"
          },
          "permission": {
            "minLength": 1,
            "type": "string"
          },
          "parameters": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "name",
                "in",
                "required",
                "schema"
              ],
              "properties": {
                "name": {
                  "minLength": 1,
                  "type": "string"
                },
                "in": {
                  "anyOf": [
                    {
                      "const": "path",
                      "type": "string"
                    },
                    {
                      "const": "query",
                      "type": "string"
                    }
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "schema": {
                  "type": "object",
                  "patternProperties": {
                    "^(.*)$": {}
                  }
                }
              }
            }
          },
          "responses": {
            "type": "object",
            "patternProperties": {
              "^[1-5][0-9]{2}$": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "description",
                  "content"
                ],
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "content": {
                    "type": "object",
                    "patternProperties": {
                      "^(.*)$": {
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "schema"
                        ],
                        "properties": {
                          "schema": {
                            "type": "object",
                            "patternProperties": {
                              "^(.*)$": {}
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "bounds": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "dateRangeInclusiveDays",
        "validIsoDatesRequired",
        "periodIndexMinimum",
        "periodIndexMaximum",
        "availabilityMaximumItems",
        "availabilityOverflow"
      ],
      "properties": {
        "dateRangeInclusiveDays": {
          "minimum": 1,
          "type": "integer"
        },
        "validIsoDatesRequired": {
          "type": "boolean"
        },
        "periodIndexMinimum": {
          "minimum": 0,
          "type": "integer"
        },
        "periodIndexMaximum": {
          "minimum": 0,
          "type": "integer"
        },
        "availabilityMaximumItems": {
          "minimum": 1,
          "type": "integer"
        },
        "availabilityOverflow": {
          "const": "ERROR_NOT_TRUNCATION",
          "type": "string"
        }
      }
    },
    "dataStates": {
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "const": "PROVEN",
            "type": "string"
          },
          {
            "const": "NO_SCHEDULE",
            "type": "string"
          },
          {
            "const": "UNPROVEN",
            "type": "string"
          },
          {
            "const": "CONFLICT",
            "type": "string"
          }
        ]
      }
    },
    "semantics": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "emptyItemsForStates",
        "positiveAvailabilityOnly",
        "historicalCurrentFallback",
        "noSchedule",
        "provenEmpty",
        "unresolved",
        "weekends",
        "staffDisplayIdentity"
      ],
      "properties": {
        "emptyItemsForStates": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "positiveAvailabilityOnly": {
          "type": "boolean"
        },
        "historicalCurrentFallback": {
          "type": "boolean"
        },
        "noSchedule": {
          "type": "string"
        },
        "provenEmpty": {
          "type": "string"
        },
        "unresolved": {
          "type": "string"
        },
        "weekends": {
          "type": "string"
        },
        "staffDisplayIdentity": {
          "type": "string"
        }
      }
    },
    "authorization": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "authentication",
        "permission",
        "capabilityAvailabilityGrantsPermission",
        "installationGrantsPermission",
        "requiredCapabilityBehavior",
        "productionReadiness"
      ],
      "properties": {
        "authentication": {
          "type": "string"
        },
        "permission": {
          "type": "string"
        },
        "capabilityAvailabilityGrantsPermission": {
          "const": false,
          "type": "boolean"
        },
        "installationGrantsPermission": {
          "const": false,
          "type": "boolean"
        },
        "requiredCapabilityBehavior": {
          "type": "string"
        },
        "productionReadiness": {
          "type": "string"
        }
      }
    }
  }
}
