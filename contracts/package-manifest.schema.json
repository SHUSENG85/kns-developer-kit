{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smkkn.top/developer-contract/v1/package-manifest.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "packageSpecVersion",
    "tool",
    "moduleId",
    "moduleVersion",
    "sourceCommit",
    "entries"
  ],
  "properties": {
    "packageSpecVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "tool": {
      "minLength": 1,
      "maxLength": 80,
      "type": "string"
    },
    "moduleId": {
      "pattern": "^[a-z][a-z0-9-]{1,39}$",
      "type": "string"
    },
    "moduleVersion": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$",
      "type": "string"
    },
    "sourceCommit": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "entries": {
      "minItems": 2,
      "maxItems": 5000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size",
          "mediaType"
        ],
        "properties": {
          "path": {
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\x00-\\x1f]+$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "size": {
            "minimum": 0,
            "type": "integer"
          },
          "mediaType": {
            "pattern": "^[a-z]+/[a-z0-9.+-]+$",
            "maxLength": 160,
            "type": "string"
          }
        }
      }
    }
  }
}
